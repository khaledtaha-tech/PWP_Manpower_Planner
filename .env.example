PORT=
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET=

# Full access remains active through this date in Saudi time. Afterward the
# application automatically becomes read only until this value is extended.
PWP_PILOT_END_DATE=2026-10-29

# Used only by: npm run create:first-admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_DISPLAY_NAME=

# Temporary recovery values used only by: npm run reset:password
# Remove both values immediately after a successful reset.
RESET_EMAIL=
RESET_PASSWORD=
